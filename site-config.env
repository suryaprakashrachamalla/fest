# Public build settings for the website, read by .github/workflows/deploy-website.yml.
# Both values end up in the published site, so this file is safe to commit.
# Changing a value and pushing to main redeploys the website with it; page routes stay the same.

# Path the site is served under: /fest on suryaprakashrachamalla.github.io, empty on a custom domain.
PUBLIC_URL=/fest
# Custom domain for GitHub Pages (e.g. shourya26.in). Leave empty to use github.io.
CUSTOM_DOMAIN=
# Public HTTPS address of the registration backend (fest-backend).
VITE_API_URL=https://genes-participation-myrtle-natural.trycloudflare.com
