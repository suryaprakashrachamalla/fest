# Docker Compose ports
BACKEND_PORT=3000
API_HOST_PORT=3001
POSTGRES_HOST_PORT=5433

# PostgreSQL (use a URL-safe password, such as a random hex string)
POSTGRES_DB=fest_registration
POSTGRES_USER=fest_app
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# App settings
NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY=
# Comma-separated website origins, e.g. http://localhost:5173,https://suryaprakashrachamalla.github.io
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Replace these placeholders with three distinct administrator credentials.
ADMIN_SUPER_NAME=Fest Administrator
ADMIN_SUPER_EMAIL=admin@example.com
ADMIN_SUPER_PASSWORD=replace-with-a-unique-password-at-least-10-characters
ADMIN_VOLUNTEER1_NAME=Fest Volunteer One
ADMIN_VOLUNTEER1_EMAIL=volunteer1@example.com
ADMIN_VOLUNTEER1_PASSWORD=replace-with-another-unique-password-at-least-10-characters
ADMIN_VOLUNTEER2_NAME=Fest Volunteer Two
ADMIN_VOLUNTEER2_EMAIL=volunteer2@example.com
ADMIN_VOLUNTEER2_PASSWORD=replace-with-a-third-unique-password-at-least-10-characters
ADMIN_VOLUNTEER3_NAME=Fest Volunteer Three
ADMIN_VOLUNTEER3_EMAIL=volunteer3@example.com
ADMIN_VOLUNTEER3_PASSWORD=replace-with-a-fourth-unique-password-at-least-10-characters

# Optional Google Sheets sync credentials. Leave blank to disable sync.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the private key on one line with literal \n between lines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
SHEETS_BATCH_SIZE=100
SHEETS_POLL_INTERVAL_MS=5000
SHEETS_RETRY_BASE_MS=2000
SHEETS_RETRY_MAX_MS=300000
SHEETS_RECONCILE_INTERVAL_MS=3600000

# Luma: approved registrations are added as guests to the matching Luma event, and Luma emails
# each member their ticket. Needs Luma Plus. API key: Luma calendar > Settings > Developer / API keys.
# Map website event slugs to Luma event IDs (evt-...), comma-separated.
LUMA_API_KEY=
LUMA_EVENT_IDS=hackathon=evt-REPLACE,no-code-vibathon=evt-REPLACE,github-workshop=evt-REPLACE,build-lab=evt-REPLACE,standup-comedy=evt-REPLACE
# Optional: the Luma ticket type each event's guests get (e.g. a free "Paid on website" ticket),
# so nobody is asked to pay again in Luma. Leave blank to use the event's default ticket.
LUMA_TICKET_TYPE_IDS=
# true = the server sends newly approved registrations to Luma and imports entrance scans automatically.
LUMA_AUTO_SYNC=false
LUMA_SYNC_INTERVAL_MS=60000

# Entry tickets: after an organizer approves a registration, each team member is emailed their own
# QR code; organizers scan it in the admin panel at the entrance.
# Option 1 (used live): Gmail API with OAuth, no App Password needed. Create a Web OAuth client in Google
# Cloud with redirect URI http://localhost:53682/oauth2callback and the Gmail API enabled, then run
#   bun src/lib/gmailAuth.ts <client.json> .env.production
# which fills in these three values and MAIL_FROM.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Option 2: any SMTP server (e.g. Gmail with an App Password, or Brevo); used only when GMAIL_* is empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SHOURYA'26 <your-address@gmail.com>
# Website address used for links in the ticket email.
PUBLIC_SITE_URL=https://shouryacse.com
TICKET_EMAIL_INTERVAL_MS=60000
