generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PaymentProofStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Lifecycle of a registration; payment review and organizer approval are separate steps.
enum RegistrationStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAYMENT_VERIFIED
  APPROVED
  TICKET_ISSUED
  PAYMENT_REJECTED
  REJECTED
}

enum FeeMode {
  FLAT
  PER_HEAD
}

enum SpreadsheetSyncStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SpreadsheetEntityType {
  USER
  EVENT
  REGISTRATION
  PARTICIPANT
  PAYMENT_PROOF
}

enum SpreadsheetOperation {
  UPSERT
}

model User {
  id                      String         @id @default(uuid())
  name                    String
  email                   String         @unique
  passwordHash            String
  role                    Role           @default(USER)
  registrations           Registration[]
  reviewedProofs          PaymentProof[] @relation("ProofReviewer")
  verifiedRegistrations   Registration[] @relation("RegistrationVerifier")
  authorizedRegistrations Registration[] @relation("AdmissionAuthorizer")
  checkedInRegistrations  Registration[] @relation("CheckInAdmin")
  approvedRegistrations   Registration[] @relation("RegistrationApprover")
  checkedInParticipants   Participant[]  @relation("ParticipantCheckIn")
  auditEntries            AuditLog[]
  analyticsExclusions     AnalyticsExclusion[] @relation("AnalyticsExclusionCreator")
  eventAnalytics          EventAnalyticsAccess[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

model Event {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  description   String?
  feePaise      Int
  // PER_HEAD multiplies feePaise by the team size.
  feeMode       FeeMode        @default(FLAT)
  minTeamSize   Int            @default(1)
  maxTeamSize   Int            @default(4)
  // Fixed ticket options, e.g. [{"size":1,"feePaise":29900,"label":"Single"},{"size":5,"feePaise":99900,"label":"Group of 5"}].
  // When set, a registration must have one of these sizes and pays that option's price.
  feeTiers      Json?
  isPublished   Boolean        @default(false)
  registrations Registration[]
  discountCodes DiscountCode[]
  analyticsViewers EventAnalyticsAccess[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Registration {
  id                  String             @id @default(uuid())
  // Short, human-friendly ID shown to participants and used as the Sheets row key.
  code                String             @unique
  userId              String
  eventId             String
  // Null for individual events (one-person registrations such as workshops and shows).
  teamName            String?
  teamSize            Int
  college             String
  phone               String
  // The amount to pay, after any team-code discount (computed by the server).
  amountPaise         Int
  // Team code used at registration (e.g. HK-7KQ2M9XP) and the discount it gave.
  discountCode        String?
  discountPaise       Int            @default(0)
  status              RegistrationStatus @default(PENDING_PAYMENT)
  approvedAt          DateTime?
  approvedById        String?
  rejectionReason     String?
  // Luma guest sync: set once every member is added to the Luma event (Luma then emails them).
  lumaSyncedAt        DateTime?
  lumaAttemptAt       DateTime?
  lumaError           String?
  verified            Boolean        @default(false)
  verifiedAt          DateTime?
  verifiedById        String?
  entryAllowed        Boolean        @default(false)
  entryAuthorizedAt   DateTime?
  entryAuthorizedById String?
  entered             Boolean        @default(false)
  enteredAt           DateTime?
  enteredById         String?
  // Hackathon portal (shouryacse.site) team login, made when the team's first member enters.
  // The password is kept encrypted only so members who missed the email can be sent it again.
  portalLogin         String?
  portalTeamId        Int?
  portalPassword      String?
  portalSyncedAt      DateTime?
  portalAttemptAt     DateTime?
  portalError         String?
  user                User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  event               Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  verifiedBy          User?          @relation("RegistrationVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  entryAuthorizedBy   User?          @relation("AdmissionAuthorizer", fields: [entryAuthorizedById], references: [id], onDelete: Restrict)
  enteredBy           User?          @relation("CheckInAdmin", fields: [enteredById], references: [id], onDelete: Restrict)
  approvedBy          User?          @relation("RegistrationApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  participants        Participant[]
  paymentProofs       PaymentProof[]
  auditEntries        AuditLog[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([userId, eventId])
  @@index([eventId, verified])
  @@index([eventId, entered])
  @@index([userId])
  @@index([status, createdAt])
  @@index([status, lumaSyncedAt])
}

model Participant {
  id             String       @id @default(uuid())
  registrationId String
  // Copied from the registration so one email can join an event only once.
  eventId        String
  name           String
  email          String
  college        String
  rollNumber     String?
  // Filled from Luma: the guest ID (gst-...) and when their ticket QR was scanned at the entrance.
  lumaGuestId    String?
  lumaCheckedInAt DateTime?
  // Entrance ticket: the QR encodes "SHOURYA26:<ticketCode>". 122 random bits, so codes can't be guessed.
  ticketCode           String    @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))
  // Set once the ticket email reached the mail server; sending starts only after organizer approval.
  ticketEmailedAt      DateTime?
  ticketEmailAttemptAt DateTime?
  ticketEmailError     String?
  // Set when an organizer scans this member's QR at the entrance (one band per member).
  checkedInAt          DateTime?
  checkedInById        String?
  // ID the scanner sent with the scan that checked this member in, so a retried request (lost
  // response) gets the same "entry authorized" answer instead of "already scanned".
  checkInScanId        String?
  // Set once this member was emailed the team's hackathon portal login.
  portalEmailedAt      DateTime?
  checkedInBy          User?        @relation("ParticipantCheckIn", fields: [checkedInById], references: [id], onDelete: Restrict)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([eventId, email])
  @@index([registrationId])
  @@index([ticketEmailedAt])
}

model PaymentProof {
  id                 String             @id @default(uuid())
  registrationId     String
  // Unique among proofs that aren't rejected (partial index "PaymentProof_utr_active_key" in the
  // migrations), so a participant can resubmit the same UTR with a clearer screenshot after a rejection.
  utr                String
  paymentMethod      String             @default("UPI")
  // The uploaded image. Cleared once it is safely copied to Google Drive (see driveFileId).
  screenshotBytes    Bytes?
  screenshotMimeType String
  // Google Drive copy of the screenshot (shourya2026 account, private folder per event).
  driveFileId        String?
  driveUploadedAt    DateTime?
  // Last copy attempt and its error, so a failed copy is retried later.
  driveAttemptAt     DateTime?
  driveError         String?
  screenshotFileName String?
  status             PaymentProofStatus @default(PENDING)
  reviewedById       String?
  reviewedAt         DateTime?
  rejectionReason    String?
  registration       Registration       @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  reviewedBy         User?              @relation("ProofReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  submittedAt        DateTime           @default(now())

  @@index([registrationId, submittedAt])
  @@index([status, submittedAt])
}

// Append-only history of registration status changes and organizer actions.
model AuditLog {
  id             String              @id @default(uuid())
  registrationId String
  actorId        String?
  action         String
  fromStatus     RegistrationStatus?
  toStatus       RegistrationStatus?
  detail         String?
  registration   Registration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor          User?               @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt      DateTime            @default(now())

  @@index([registrationId, createdAt])
}

model PaymentQrCode {
  id        String   @id @default(uuid())
  label     String
  imageBytes Bytes
  mimeType  String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SpreadsheetSyncOutbox {
  id          String                @id @default(uuid())
  entityType  SpreadsheetEntityType
  entityId    String
  operation   SpreadsheetOperation  @default(UPSERT)
  payload     Json
  status      SpreadsheetSyncStatus @default(PENDING)
  attempts    Int                   @default(0)
  lastError   String?
  createdAt   DateTime              @default(now())
  nextAttemptAt DateTime?           @default(now())
  processedAt DateTime?

  @@index([status, nextAttemptAt, createdAt])
  @@index([entityType, entityId])
}

// Super-admin rules that keep test data out of the analytics (the overview read from Google
// Sheets). Nothing is deleted: excluded records stay in the sheet and the database, and are shown
// separately as test data.
enum AnalyticsExclusionKind {
  // One registration, by its registration ID (SG26-...).
  REGISTRATION
  // Every registration made by this account (the email it signs in with).
  ACCOUNT
}

model AnalyticsExclusion {
  id          String                 @id @default(uuid())
  kind        AnalyticsExclusionKind
  // Registration ID (upper case) or account email (lower case).
  value       String
  reason      String
  createdById String?
  createdBy   User?                  @relation("AnalyticsExclusionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())

  @@unique([kind, value])
}

// Team codes: each takes amountPaise off one registration for its own event, and works once.
// A code is released again if the registration that used it is rejected.
model DiscountCode {
  id                   String    @id @default(uuid())
  code                 String    @unique
  eventId              String
  amountPaise          Int
  usedByRegistrationId String?   @unique
  usedAt               DateTime?
  event                Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())

  @@index([eventId])
}

// Read-only analytics for chosen events, given to a normal (non-organizer) account. Grants
// nothing else: no organizer pages, no other events, no global totals.
model EventAnalyticsAccess {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}
